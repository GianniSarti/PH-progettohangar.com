---
import Base from '../layouts/Base.astro';
import Counter from './Counter';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale}>
  <main class="mx-auto max-w-2xl p-8">
    <h1 class="text-3xl font-bold">{t(locale, 'home.heading')}</h1>
    <p class="mt-2 text-slate-600">{t(locale, 'home.subtitle')}</p>
    <div class="mt-6">
      <Counter client:load label={t(locale, 'counter.label')} />
    </div>
  </main>
</Base>
